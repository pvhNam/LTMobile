<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:name="com.example.doanmb.MyApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DOANMB">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <service
            android:name=".core.service.CarviaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name=".core.service.OrderReminderService"
            android:exported="false" />

        <receiver
            android:name=".core.service.OrderReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.doanmb.ACTION_CHECK_REMINDER" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="carvia_chat" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/colorPrimary" />
        <activity
            android:name="com.example.doanmb.ui.auth.view.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.DOANMB">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.example.doanmb.ui.home.view.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name="com.example.doanmb.ui.car.view.CarDetailActivity" android:exported="false" />
        <activity android:name="com.example.doanmb.ui.car.view.InvoiceActivity" android:exported="false" />
        <activity android:name="com.example.doanmb.ui.car.view.MapPickerActivity" android:exported="false" />
        <activity android:name="com.example.doanmb.ui.car.view.FavoriteCarsActivity" android:exported="false" />
        <activity android:name="com.example.doanmb.ui.auth.view.LoginActivity" />
        <activity android:name="com.example.doanmb.ui.auth.view.RegisterActivity" />
        <activity android:name="com.example.doanmb.ui.auth.view.ForgotPassActivity" />
        <activity android:name="com.example.doanmb.ui.admin.view.AdminDashboardActivity"
            android:theme="@style/Theme.DOANMB.Admin" />
        <activity android:name="com.example.doanmb.ui.driver.view.DriverDashboardActivity"
            android:theme="@style/Theme.DOANMB.Driver" />
        <activity android:name="com.example.doanmb.ui.driver.view.DriverRegisterActivity"
            android:theme="@style/Theme.DOANMB.Driver" />
        <activity android:name="com.example.doanmb.ui.admin.view.AdminRevenueDetailActivity"
            android:theme="@style/Theme.DOANMB.Admin" />
        <activity android:name="com.example.doanmb.ui.admin.view.AdminCarDetailActivity"
            android:theme="@style/Theme.DOANMB.Admin" />
        <activity android:name="com.example.doanmb.ui.admin.view.AdminUserDetailActivity"
            android:theme="@style/Theme.DOANMB.Admin" />
        <activity android:name="com.example.doanmb.ui.activity.AdminOrderDetailActivity"
            android:theme="@style/Theme.DOANMB.Admin" />
        <activity
            android:name="com.example.doanmb.ui.chat.view.ChatDetailActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.media.view.FullscreenImageActivity"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.MaterialComponents.NoActionBar" />

        <activity
            android:name=".ui.media.view.VideoPlayerActivity"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize"
            android:theme="@style/Theme.MaterialComponents.NoActionBar" />

        <activity
            android:name=".ui.media.view.FullscreenMediaActivity"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity android:name=".ui.profile.view.WalletActivity" android:exported="false" />
        <activity android:name=".ui.profile.view.VnpayPaymentActivity" android:exported="false" />
        <activity android:name=".ui.profile.view.AboutUsActivity" />
        <activity android:name=".ui.profile.view.GiftsActivity" />
        <activity android:name=".ui.profile.view.ReferralActivity" />
        <activity android:name=".ui.profile.view.PrivacyActivity" />
        <activity android:name=".ui.profile.view.SupportActivity" />
        <activity android:name=".ui.car.view.ReviewActivity" />
    </application>
</manifest>