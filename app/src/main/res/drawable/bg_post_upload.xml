<?xml version="1.0" encoding="utf-8"?>
<!-- Ô thêm ảnh kiểu Liquid Glass: kính mờ + viền đứt nét màu accent -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/lg_glass_fill_soft" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/lg_accent"
        android:dashWidth="8dp"
        android:dashGap="4dp" />
</shape>
