<?xml version="1.0" encoding="utf-8"?>
<!-- Card kính cho dialog: vẫn gradient kính + viền sáng nhưng nền đặc (~94% trắng)
     để chữ luôn rõ trên nền blur. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#F7FFFFFF"
                android:centerColor="#F0FFFFFF"
                android:endColor="#EAFCFEFF" />
            <stroke
                android:width="1dp"
                android:color="@color/lg_glass_stroke" />
        </shape>
    </item>
    <!-- Highlight cạnh trên cho cảm giác kính -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/lg_glass_stroke" />
        </shape>
    </item>
</layer-list>
