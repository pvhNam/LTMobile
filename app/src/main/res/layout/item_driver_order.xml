<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/lg_glass_fill_strong"
    app:strokeColor="@color/lg_glass_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- TRẠNG THÁI -->
        <TextView
            android:id="@+id/tv_do_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#FF9800"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <!-- TÊN XE -->
        <TextView
            android:id="@+id/tv_do_car_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/color_on_background"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- GIÁ -->
        <TextView
            android:id="@+id/tv_do_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E53935"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <!-- KHÁCH -->
        <TextView
            android:id="@+id/tv_do_renter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/color_on_surface_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <!-- GHI CHÚ -->
        <TextView
            android:id="@+id/tv_do_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/color_on_surface_secondary"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <!-- NGÀY -->
        <TextView
            android:id="@+id/tv_do_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/color_on_surface_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="10dp" />

        <!-- NÚT PENDING: Chấp nhận / Từ chối (dùng ở Driver Home, ẩn ở đây) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btn_do_accept"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="✅ Chấp nhận"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4CAF50"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_do_reject"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="❌ Từ chối"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F44336"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- NÚT ACCEPTED: Bắt đầu chuyến -->
        <Button
            android:id="@+id/btn_do_start"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🚗 Bắt đầu chuyến"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- NÚT IN_PROGRESS: Hoàn thành chuyến -->
        <Button
            android:id="@+id/btn_do_complete"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🏁 Hoàn thành chuyến"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1976D2"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>