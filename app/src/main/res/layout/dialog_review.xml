<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── HEADER ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="20dp"
            android:paddingHorizontal="20dp"
            android:background="@drawable/bg_review_header_teal">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_circle_white_alpha_review">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="⭐"
                    android:textSize="28sp" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đánh giá tài xế"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Hãy chia sẻ trải nghiệm của bạn 🙌"
                android:textColor="#CCF5F6"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ── BODY (scrollable) ── -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <!-- Rating section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_round_16"
                    android:backgroundTint="@color/lg_accent_pale"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:paddingHorizontal="12dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bạn cảm thấy thế nào?"
                        android:textColor="@color/lg_accent_text"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <!-- RatingBar không dùng scale để tránh bị cắt -->
                    <RatingBar
                        android:id="@+id/rating_bar_input"
                        style="?android:attr/ratingBarStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:numStars="5"
                        android:stepSize="1"
                        android:rating="0"
                        android:progressTint="#FF9800"
                        android:secondaryProgressTint="#FFE0B2" />

                    <TextView
                        android:id="@+id/tv_rating_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Chạm vào ngôi sao để đánh giá"
                        android:textColor="@color/lg_accent_dark"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Gợi ý nhanh label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gợi ý nhanh"
                    android:textColor="@color/color_on_surface_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Row 1 chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_ontime"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:text="⏰ Đúng giờ"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:textColor="@color/lg_accent_text"
                        android:clickable="true"
                        android:focusable="true"
                        app:chipBackgroundColor="@color/lg_accent_pale"
                        app:chipStrokeColor="@color/lg_accent_soft"
                        app:chipStrokeWidth="1dp"
                        app:chipCornerRadius="19dp"
                        app:chipMinHeight="38dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_safe"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:text="🛡️ An toàn"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:textColor="@color/lg_accent_text"
                        android:clickable="true"
                        android:focusable="true"
                        app:chipBackgroundColor="@color/lg_accent_pale"
                        app:chipStrokeColor="@color/lg_accent_soft"
                        app:chipStrokeWidth="1dp"
                        app:chipCornerRadius="19dp"
                        app:chipMinHeight="38dp" />
                </LinearLayout>

                <!-- Row 2 chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_friendly"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:text="😊 Thân thiện"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:textColor="@color/lg_accent_text"
                        android:clickable="true"
                        android:focusable="true"
                        app:chipBackgroundColor="@color/lg_accent_pale"
                        app:chipStrokeColor="@color/lg_accent_soft"
                        app:chipStrokeWidth="1dp"
                        app:chipCornerRadius="19dp"
                        app:chipMinHeight="38dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_clean"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:text="✨ Xe sạch sẽ"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:textColor="@color/lg_accent_text"
                        android:clickable="true"
                        android:focusable="true"
                        app:chipBackgroundColor="@color/lg_accent_pale"
                        app:chipStrokeColor="@color/lg_accent_soft"
                        app:chipStrokeWidth="1dp"
                        app:chipCornerRadius="19dp"
                        app:chipMinHeight="38dp" />
                </LinearLayout>

                <!-- Text input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Nhận xét của bạn (tuỳ chọn)..."
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="@color/lg_accent"
                    app:boxStrokeWidth="1.5dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/lg_accent"
                    app:counterEnabled="true"
                    app:counterMaxLength="200">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_review_comment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="3"
                        android:maxLines="4"
                        android:gravity="top"
                        android:textSize="14sp"
                        android:textColor="@color/color_on_background"
                        android:inputType="textMultiLine|textCapSentences"
                        android:padding="12dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Buttons — chiều cao cố định, không bị cắt -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cancel_review"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Để sau"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:textColor="@color/lg_accent"
                        app:cornerRadius="24dp"
                        app:strokeColor="@color/lg_accent"
                        app:strokeWidth="1.5dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_submit_review"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.6"
                        android:layout_marginStart="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="⭐ Gửi đánh giá"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        app:backgroundTint="@color/lg_accent"
                        app:cornerRadius="24dp"
                        app:rippleColor="#33FFFFFF" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>