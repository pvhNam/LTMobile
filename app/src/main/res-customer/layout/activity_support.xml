<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_liquid_glass"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            style="@style/CarviaPageHeader"
            android:id="@+id/header_bar"
            >

            <ImageView
                style="@style/CarviaPageHeaderBack"
                android:id="@+id/btn_back"
                />

            <TextView
                style="@style/CarviaPageHeaderTitle"
                android:text="Trung tâm hỗ trợ" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬"
                android:textSize="72sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="CARVIA luôn sẵn sàng hỗ trợ"
                android:textColor="@color/lg_accent"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Giải đáp vấn đề về xe, tài xế và giao dịch"
                android:textColor="@color/lg_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Liên hệ nhanh"
                android:textColor="@color/lg_accent"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="6dp"
                android:text="Hotline: 0862210723&#10;Email: 23130365@st.hcmuaf.edu.vn&#10;Thời gian hỗ trợ: 24/7"
                android:textColor="@color/lg_text"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Các vấn đề thường gặp"
                android:textColor="@color/lg_accent"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="6dp"
                android:text="• Không thể đăng nhập tài khoản&#10;• Cách đăng bán hoặc cho thuê xe&#10;• Cách đăng ký trở thành tài xế&#10;• Vấn đề về thanh toán hoặc giao dịch&#10;• Báo cáo tài khoản hoặc nội dung không phù hợp"
                android:textColor="@color/lg_text"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_glass_button"
            android:gravity="center"
            android:paddingVertical="13dp"
            android:text="Gửi yêu cầu hỗ trợ"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:text="© 2026 CARVIA Team&#10;Đồ án môn Lập trình Thiết bị Di động"
            android:textColor="@color/lg_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
