<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/lg_glass_fill_strong"
    app:strokeColor="@color/lg_glass_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HÀNG 1: Badge loại đơn + trạng thái -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvOrderType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_pill_round"
                android:text="Thuê xe"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvOrderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏳ Chờ xác nhận"
                android:textColor="#FF9800"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- HÀNG 2: Tên xe -->
        <TextView
            android:id="@+id/tvOrderCarName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toyota Camry 2022"
            android:textColor="@color/lg_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- HÀNG 3: Giá -->
        <TextView
            android:id="@+id/tvOrderCarPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="850.000đ / ngày"
            android:textColor="@color/lg_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/lg_glass_stroke_dim"
            android:layout_marginBottom="10dp" />

        <!-- HÀNG 4: Ngày gửi -->
        <TextView
            android:id="@+id/tvOrderDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅  Ngày gửi: --"
            android:textColor="@color/lg_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <!-- HÀNG 5: Ghi chú (ẩn nếu không có) -->
        <TextView
            android:id="@+id/tvOrderNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/lg_text_secondary"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- HÀNG 6: Hộp thông báo trạng thái -->
        <LinearLayout
            android:id="@+id/layoutStatusMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_round_16"
            android:backgroundTint="@color/lg_accent_pale"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:layout_marginBottom="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvStatusMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- HÀNG 7: Nút đánh giá tài xế (chỉ hiện khi completed + canReview) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_review_driver"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="⭐  Đánh giá tài xế"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#FF9800"
            app:cornerRadius="12dp"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>