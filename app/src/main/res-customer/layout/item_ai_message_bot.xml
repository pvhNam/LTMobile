<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="60dp"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/tv_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_msg_received"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:text="Nội dung trả lời của trợ lý AI"
        android:textColor="#1A1A2E"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp" />

    <!-- Danh sách xe được AI gợi ý (mỗi item bấm để mở link bài đăng) -->
    <LinearLayout
        android:id="@+id/layout_suggested_cars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical" />
</LinearLayout>
