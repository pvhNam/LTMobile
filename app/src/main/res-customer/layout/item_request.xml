<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ "Yêu cầu": KHUNG rõ ràng (viền + bóng + bo góc) do MaterialCardView lo,
     bên trong là BlurView blur thật nội dung phía sau (Liquid Glass). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true"
    app:strokeColor="@color/lg_glass_stroke"
    app:strokeWidth="1.5dp">

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blur_request"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/lg_glass_fill_soft">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- LOẠI YÊU CẦU + TRẠNG THÁI + THỜI GIAN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRequestType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_type"
                    android:paddingStart="11dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="4dp"
                    android:text="Mua xe"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRequestStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="⏳ Chờ xác nhận"
                    android:textColor="#FF9800"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRequestTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="vừa xong"
                    android:textColor="@color/color_on_surface_tertiary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- TÊN XE -->
            <TextView
                android:id="@+id/tvRequestCarName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Toyota Vios 2020"
                android:textColor="@color/color_on_background"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- GIÁ XE -->
            <TextView
                android:id="@+id/tvRequestCarPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="450.000.000 VNĐ"
                android:textColor="#E5484D"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- KHỐI THÔNG TIN NGƯỜI MUA/THUÊ (panel nhẹ cho rõ) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_hint_box"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvBuyerInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤  Người mua: Nguyễn Văn A"
                    android:textColor="@color/color_on_surface_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvBuyerPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="📞  0901234567"
                    android:textColor="@color/color_on_surface_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvBuyerCCCD"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="🪪  CCCD: 123456789012"
                    android:textColor="@color/color_on_surface_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvRentInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="📅  Thuê từ: 20/05/2026 | 3 ngày"
                    android:textColor="@color/color_on_surface_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- GHI CHÚ -->
            <TextView
                android:id="@+id/tvRequestNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_hint_box"
                android:padding="10dp"
                android:text="💬  Ghi chú: ..."
                android:textColor="@color/color_on_surface_secondary"
                android:textSize="13sp" />

            <!-- 2 NÚT XÁC NHẬN / TỪ CHỐI -->
            <LinearLayout
                android:id="@+id/layoutActionButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirm"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/lg_accent"
                    app:strokeColor="@color/lg_glass_stroke"
                    app:strokeWidth="1dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="✅ Xác nhận"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReject"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:backgroundTint="#E5484D"
                    app:strokeColor="@color/lg_glass_stroke"
                    app:strokeWidth="1dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="❌ Từ chối"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="24dp" />
            </LinearLayout>

            <!-- Hành động cho ĐƠN MÌNH GỬI ĐI (đi thuê): Gia hạn + Hủy -->
            <LinearLayout
                android:id="@+id/layoutMyActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExtend"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/lg_accent"
                    app:strokeColor="@color/lg_glass_stroke"
                    app:strokeWidth="1dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="📅 Gia hạn"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelOwn"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:backgroundTint="#E5484D"
                    app:strokeColor="@color/lg_glass_stroke"
                    app:strokeWidth="1dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="❌ Hủy"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="24dp" />
            </LinearLayout>

            <!-- Nút CHỦ XE xác nhận khách đã trả xe -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkReturned"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#2E7D32"
                app:strokeColor="@color/lg_glass_stroke"
                app:strokeWidth="1dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="🚗 Xác nhận đã trả xe"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="24dp" />

            <!-- Nút KHÁCH xem & thanh toán hóa đơn -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewInvoice"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#F9A825"
                app:strokeColor="@color/lg_glass_stroke"
                app:strokeWidth="1dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="🧾 Xem &amp; thanh toán hóa đơn"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="24dp" />

            <!-- Hiện khi đã xử lý -->
            <TextView
                android:id="@+id/tvDoneLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Đã xử lý"
                android:textColor="@color/color_on_surface_tertiary"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>
</com.google.android.material.card.MaterialCardView>
