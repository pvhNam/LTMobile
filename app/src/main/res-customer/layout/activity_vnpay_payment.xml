<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_liquid_glass"
    android:orientation="vertical">

    <RelativeLayout
        style="@style/CarviaPageHeader"
        android:id="@+id/header_bar">

        <ImageView
            style="@style/CarviaPageHeaderBack"
            android:id="@+id/btn_vnpay_back"
            android:contentDescription="Huỷ"
            />

        <TextView
            style="@style/CarviaPageHeaderTitle"
            android:text="Thanh toán VNPay" />
    </RelativeLayout>

    <ProgressBar
        android:id="@+id/vnpay_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true" />

    <WebView
        android:id="@+id/vnpay_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>
