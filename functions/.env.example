# Cấu hình VNPay sandbox cho chức năng nạp ví.
# Tạo file functions/.env (copy từ file này) và điền giá trị thật từ trang
# merchant sandbox VNPay: https://sandbox.vnpayment.vn/
#
# Sau khi deploy, vào trang quản trị merchant sandbox khai báo IPN URL trỏ tới:
#   https://<region>-<project-id>.cloudfunctions.net/vnpayIpn

VNP_TMN_CODE=TMNCODE_SANDBOX_CUA_BAN
VNP_HASH_SECRET=HASHSECRET_SANDBOX_CUA_BAN

# URL trang trả kết quả (function vnpayReturn) sau khi deploy, ví dụ:
#   https://us-central1-<project-id>.cloudfunctions.net/vnpayReturn
VNP_RETURN_URL=https://us-central1-<project-id>.cloudfunctions.net/vnpayReturn

# (Tuỳ chọn) URL cổng thanh toán sandbox — mặc định đã đúng, không cần đổi:
# VNP_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
